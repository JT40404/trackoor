# Required. Get a key at https://dashboard.helius.dev
HELIUS_API_KEY=

# Optional: full RPC URL override (e.g. a dedicated Helius node). Takes precedence over HELIUS_API_KEY.
HELIUS_RPC_URL=

# Optional but recommended in production: shared cache + rate limiting across serverless instances.
# Add "Upstash Redis" from the Vercel Marketplace and these are set for you.
# (KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuning (defaults shown)
EARLY_BUYER_LIMIT=30
LAUNCH_TX_LIMIT=300
HELIUS_CONCURRENCY=8
RATE_LIMIT_PER_MINUTE=20
